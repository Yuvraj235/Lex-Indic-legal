# ─────────────────────────────────────────────────────────────────────────────
# LEX-INDIC — Configuration template
#
# Copy this file to .env and fill in the values.  Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ─── REQUIRED — AI provider keys ─────────────────────────────────────────────
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
# Get a free Groq key at:   https://console.groq.com/keys
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here


# ─── OPTIONAL — White-label PDF letterhead ───────────────────────────────────
# Override these to ship the case-brief PDF under a specific firm's brand.
# All five are optional; defaults fall back to the Lex-Indic branding.
# The "Lex-Indic BNS Transition Engine" attribution stays in the cover-page
# meta row regardless — that's deliberate, it disclaims AI authorship.
#
# LAW_FIRM_NAME=SINGHANIA & PARTNERS
# LAW_FIRM_TAGLINE=ADVOCATES & SOLICITORS
# LAW_FIRM_SUBTITLE=Mumbai · Delhi · Bengaluru
# LAW_FIRM_HEADER=Singhania & Partners | BNS Case Brief | CONFIDENTIAL
# LAW_FIRM_DISCLAIMER=Prepared by Singhania & Partners as a draft. Must be reviewed by the assigned advocate before filing.


# ─── MODE — development vs production ────────────────────────────────────────
# Unset (or anything else) = production behaviour: the app refuses to start
# without SECRET_KEY + AUDIT_HASH_SALT, never echoes login codes, keeps the
# admin API closed without ADMIN_TOKEN, and only accepts https webhooks.
# Set development on your own machine for those conveniences.
#
# LEX_ENV=development


# ─── PRODUCTION — Secrets (the app won't boot without them) ──────────────────
# Generate each with:  python3 -c "import secrets; print(secrets.token_hex(32))"
#
# SECRET_KEY signs session cookies, download links, firm invites and API-key
# hashes. Keep it separate from AUDIT_HASH_SALT: the DPDP erasure job rotates
# the salt, and that must not log every user out.
# SECRET_KEY=
#
# AUDIT_HASH_SALT is mixed into the SHA-256 hash of every client story, so
# hashes can't be cross-referenced across customer deployments.
# AUDIT_HASH_SALT=
# AUDIT_LOG_DIR=outputs/audit
#
# ADMIN_TOKEN unlocks /dashboard, /admin/* and operator APIs. Sent only as the
# X-Admin-Token header (never in a URL). Unset = admin API disabled.
# ADMIN_TOKEN=


# ─── PRODUCTION — Behind a reverse proxy ─────────────────────────────────────
# Number of proxies in front of the app whose X-Forwarded-For/-Proto to trust
# (Fly, Render, a single nginx = 1). Unset = trust none; a client-sent
# X-Forwarded-For is ignored either way.
# TRUST_PROXY_HOPS=1
#
# Extra origins allowed to call /convert/* cross-origin (comma-separated).
# The Word add-in doesn't need this — its task pane is served from this host.
# CORS_ALLOWED_ORIGINS=https://word-integration.your-firm.in


# ─── OPTIONAL — Fully local deployment (no client data leaves the server) ────
# Generation and RAG embeddings are separate: set BOTH to keep stories local.
# /llm/status reports "fully_local": true only when both are ollama.
#
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.3:70b
# EMBEDDINGS_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=nomic-embed-text      # ollama pull nomic-embed-text
# OLLAMA_HOST=http://localhost:11434


# ─── OPTIONAL — WhatsApp intake (/wa/inbound) ────────────────────────────────
# Closed unless one of these is set (see docs/WHATSAPP_INTAKE.md).
# TWILIO_AUTH_TOKEN=                       # verifies X-Twilio-Signature
# WA_PUBLIC_URL=https://your-host/wa/inbound
# WA_INBOUND_TOKEN=                        # MSG91 / n8n shared token
#
# NALSA registry export for the SLSA (X-Export-Token header).
# NALSA_EXPORT_TOKEN=


# ─── OPTIONAL — e-Courts live CNR lookup ─────────────────────────────────────
# Default is ECOURTS_PROVIDER=stub: the /ecourts page serves 3 clearly-synthetic
# demo cases (source="stub").  To return REAL case status by CNR, sign up for a
# keyed e-Courts API and switch to live mode.  No official free JSON API exists;
# these third parties mirror services.ecourts.gov.in and give free starter
# credits (no card):
#   • ecourtsindia.com  — ₹200 free credits  (default target below)
#   • court-api.kleopatra.io — 30 free requests (set ECOURTS_API_BASE/PATH to it)
# In live mode there is NO stub fallback — a miss returns "not found".
#
# ECOURTS_PROVIDER=live
# ECOURTS_API_KEY=eci_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ECOURTS_API_BASE=https://webapi.ecourtsindia.com
# ECOURTS_API_PATH=/api/partner/case/{cnr}


# ─── DEVELOPMENT — Anything else ─────────────────────────────────────────────
# (none required at the moment)
