<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Lex-Indic IPC -> BNS Word Add-in
  Manifest (Office Add-ins / Word)

  This file declares the add-in to Microsoft Word. Office reads it, then
  loads our task pane (taskpane.html) into a sidebar inside Word whenever the
  user clicks the "Convert IPC -> BNS" button on the Home ribbon.

  Sideload (developer install) - see /addin/install for a friendlier guide:
    1. Run Lex-Indic with the https flag (python3 app.py with the https switch)
    2. Open Word.
    3. Insert, Add-ins, Upload My Add-in, pick this file.
    4. Trust the self-signed certificate when prompted.

  Production install:
    Replace https://localhost:8443 with your production URL throughout.
    For Microsoft 365, deploy via Centralised Deployment in the admin centre.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- Add-in identity. Regenerate Id if forking. -->
  <Id>d3b1d4ce-7c95-4dca-b1a5-9d4e9e3f1a01</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Lex-Indic</ProviderName>
  <DefaultLocale>en-IN</DefaultLocale>

  <DisplayName        DefaultValue="Lex-Indic: IPC → BNS Converter"/>
  <Description        DefaultValue="Convert old IPC-era pleadings to BNS 2023 directly inside Word. Every IPC reference is highlighted and the BNS equivalent inserted next to it for your review."/>

  <IconUrl           DefaultValue="https://localhost:8443/static/addin/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:8443/static/addin/icon-80.png"/>

  <SupportUrl        DefaultValue="https://github.com/Yuvraj235/Lex-Indic-legal"/>

  <!-- Domains this add-in is allowed to navigate to. -->
  <AppDomains>
    <AppDomain>https://localhost:8443</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>  <!-- Word -->
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:8443/addin/taskpane"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <!-- ──────────────────────────────────────────────────────────────────────
       Version overrides: this is where modern Office reads the ribbon button,
       commands, and version-specific extensions.  The old <DefaultSettings>
       above is kept for backwards compatibility with older Word builds.
       ────────────────────────────────────────────────────────────────────── -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">

    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>

          <GetStarted>
            <Title          resid="GetStarted.Title"/>
            <Description    resid="GetStarted.Description"/>
            <LearnMoreUrl   resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <!-- Default task pane behaviour when add-in opens -->
          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="LexIndic.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="LexIndic.OpenPane">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title       resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>LexIndic.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:8443/static/addin/icon-32.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:8443/static/addin/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:8443/static/addin/icon-80.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Commands.Url"   DefaultValue="https://localhost:8443/addin/commands"/>
        <bt:Url id="Taskpane.Url"   DefaultValue="https://localhost:8443/addin/taskpane"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/Yuvraj235/Lex-Indic-legal"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="GetStarted.Title"      DefaultValue="Lex-Indic IPC → BNS Converter"/>
        <bt:String id="Group.Label"           DefaultValue="Lex-Indic"/>
        <bt:String id="Button.Label"          DefaultValue="Convert IPC → BNS"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="GetStarted.Description"
          DefaultValue="Open the task pane and click 'Convert document' to find every IPC section reference in this Word document and insert the BNS 2023 equivalent next to it.  Original formatting is preserved; you review and accept each change."/>
        <bt:String id="Button.Tooltip"
          DefaultValue="Find every IPC section reference in the active document and insert the BNS 2023 equivalent next to it."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
