# Environment & secrets
.env
.env.*
# but DO commit the template (no secrets in it)
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Generated outputs (user-specific)
outputs/

# ChromaDB local storage
chroma_db/

# Embedding cache (Day 26: committed to git so Docker deploys ship with it
# pre-warmed — kills the 90-sec cold start on Render / HF / Fly etc.
# Regenerate locally with: python3 tools/prewarm_embeddings.py
# Then `git add data/legal_corpus/embedding_cache.json && git commit`
# data/legal_corpus/embedding_cache.json    ← ALLOWED IN GIT NOW

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Claude Code
.claude/

# Self-signed dev TLS certs (used by --https for the Word add-in)
# Each clone generates its own. See templates/addin/install.html.
certs/*.pem
certs/*.key

# SOC 2 audit-log size baseline — auto-regenerated on every controls check.
# Tracking it creates noisy commits.  The live file remains for auditor review.
tools/soc2/evidence/audit_log_sizes.json

# Fine-tuning data (Day 26). train.jsonl is large and fully regenerable from the
# verified KB via tools/generate_instruction_data.py, so it stays out of git.
# eval.jsonl + eval_report.* ARE committed — the held-out set is the audit artifact.
data/finetune/train.jsonl
data/finetune/review_sample.jsonl
# Eval reports are regenerable evidence (change per model run) — keep eval.jsonl only.
data/finetune/eval_report.*
data/finetune/pipeline_eval_report.*
